// Deft Energy Solutions — core data model (Stage E).
// This is the multi-tenant core of the 61-table spec (SPEC_V1 §C). Every
// org-scoped table carries `orgId`; row-level security (prisma/rls.sql) enforces
// isolation at the DB. The remaining tables (interval data at scale, full
// trading/audit/marketplace) layer on in later passes.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------- enums

enum Role {
  OWNER
  FACILITY_MANAGER
  ENERGY_MANAGER
  AUDITOR
  CFO
  CEO
  ADMIN
}

enum Plan {
  FREE
  PRO
  ENTERPRISE
}

enum BuildingType {
  INDUSTRIAL
  COMMERCIAL
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TaskSource {
  DIAGNOSIS
  ALERT
  AUDIT
}

enum Priority {
  HIGH
  MEDIUM
  LOW
}

enum AlertSeverity {
  CRITICAL
  WARNING
  INFO
}

enum AlertStatus {
  NEW
  ACKNOWLEDGED
  RESOLVED
}

enum CapexStage {
  FM
  EM
  CFO
  BOARD
  APPROVED
  REJECTED
}

enum FindingStatus {
  LOSS
  HEALTHY
  NEEDS_DATA
}

enum FindingKind {
  RECOVERABLE
  OPPORTUNITY
}

// ----------------------------------------------------------------- core

model Organisation {
  id        String   @id @default(uuid())
  name      String
  gstin     String?
  plan      Plan     @default(FREE)
  createdAt DateTime @default(now())

  users         User[]
  buildings     Building[]
  bills         ElectricityBill[]
  tasks         Task[]
  alertRules    AlertRule[]
  alerts        AlertInstance[]
  documents     Document[]
  activity      ActivityLog[]
  subscriptions Subscription[]
  capexRequests CapexRequest[]
  ghgInventory  GhgInventory[]
  extractionFeedback ExtractionFeedback[]
  discomLicenses DiscomLicense[]
  collections    Collection[]
  remittances    Remittance[]
}

model User {
  id        String   @id @default(uuid())
  orgId     String
  email     String   @unique
  name      String
  role      Role     @default(FACILITY_MANAGER)
  createdAt DateTime @default(now())

  org         Organisation             @relation(fields: [orgId], references: [id])
  preferences NotificationPreference[]

  @@index([orgId])
}

model Subscription {
  id           String    @id @default(uuid())
  orgId        String
  plan         Plan
  status       String    @default("active")
  startDate    DateTime  @default(now())
  endDate      DateTime?
  billingCycle String    @default("monthly")
  amountInr    Int       @default(0)

  org Organisation @relation(fields: [orgId], references: [id])

  @@index([orgId])
}

model Building {
  id                String       @id @default(uuid())
  orgId             String
  name              String
  city              String
  type              BuildingType
  discom            String
  supplyVoltage     String?
  tariffCategory    String?
  areaSqft          Int?
  sanctionedLoadKw  Int?
  contractDemandKva Int?
  pf                Float?
  epi               Float?
  savingsInr        Int          @default(0)
  billsReceived     Int          @default(0)
  billsExpected     Int          @default(0)
  // 12-month spend trend in ₹ lakh, aligned to MONTHS (Jul…Jun).
  trendL            Float[]
  createdAt         DateTime     @default(now())

  org       Organisation      @relation(fields: [orgId], references: [id])
  zones     BuildingZone[]
  equipment Equipment[]
  bills     ElectricityBill[]
  intervals IntervalReading[]

  @@index([orgId])
}

model BuildingZone {
  id         String   @id @default(uuid())
  buildingId String
  name       String
  areaSqft   Int?
  building   Building @relation(fields: [buildingId], references: [id])

  @@index([buildingId])
}

model Equipment {
  id         String   @id @default(uuid())
  buildingId String
  name       String
  type       String
  ratingKw   Float?
  building   Building @relation(fields: [buildingId], references: [id])

  @@index([buildingId])
}

// The 42 extracted fields (SPEC_V1 §A). All nullable — partial extraction is valid.
model ElectricityBill {
  id         String   @id @default(uuid())
  orgId      String
  buildingId String?
  fileUrl    String?
  createdAt  DateTime @default(now())

  consumerNumber       String?
  consumerName         String?
  address              String?
  discom               String?
  tariffCategory       String?
  supplyVoltage        String?
  sanctionedLoadKw     Float?
  contractDemandKva    Float?
  billingDemandKva     Float?
  maxDemandKva         Float?
  mdDateTime           String?
  energyKwh            Float?
  reactiveKvarh        Float?
  apparentKvah         Float?
  powerFactor          Float?
  loadFactorPct        Float?
  fixedDemandCharges   Float?
  energyCharges        Float?
  wheelingCharges      Float?
  crossSubsidySurcharge Float?
  additionalSurcharge  Float?
  pfPenaltyAmt         Float?
  pfPenaltyRatePct     Float?
  todPeakKwh           Float?
  todOffPeakKwh        Float?
  todNormalKwh         Float?
  todPeakRate          Float?
  todOffPeakRate       Float?
  todShoulderRate      Float?
  facFppca             Float?
  electricityDuty      Float?
  meterRent            Float?
  transformerLossPct   Float?
  arrears              Float?
  latePaymentSurcharge Float?
  earlyPaymentRebate   Float?
  netMeteringCredit    Float?
  totalAmountDue       Float?
  billDate             String?
  dueDate              String?
  billingPeriodDays    Int?
  meterNumber          String?

  // Payment / due-date tracking (Stage 1). `dueOn` is the parsed `dueDate` for
  // querying; `paidAt`/`paidAmount` are null until the bill is marked paid.
  // Status (overdue / due-soon / paid-on-time / paid-late) is DERIVED, never stored.
  dueOn      DateTime?
  paidAt     DateTime?
  paidAmount Float?

  org       Organisation @relation(fields: [orgId], references: [id])
  building  Building?    @relation(fields: [buildingId], references: [id])
  diagnosis Diagnosis?

  @@index([orgId])
  @@index([buildingId])
  @@index([dueOn])
}

model Diagnosis {
  id             String   @id @default(uuid())
  billId         String   @unique
  recoverableInr Int      @default(0)
  opportunityInr Int      @default(0)
  createdAt      DateTime @default(now())

  bill     ElectricityBill @relation(fields: [billId], references: [id])
  findings LossFinding[]
}

model LossFinding {
  id          String        @id @default(uuid())
  diagnosisId String
  checkId     String // e.g. "1.1"
  category    Int
  status      FindingStatus
  kind        FindingKind
  annualInr   Int?
  note        String?

  diagnosis Diagnosis @relation(fields: [diagnosisId], references: [id])

  @@index([diagnosisId])
}

// ------------------------------------------------------ cross-cutting

model Task {
  id         String     @id @default(uuid())
  orgId      String
  title      String
  building   String
  source     TaskSource
  priority   Priority
  assignee   String
  due        String
  savingsInr Int?
  status     TaskStatus @default(TODO)
  createdAt  DateTime   @default(now())

  org Organisation @relation(fields: [orgId], references: [id])

  @@index([orgId])
}

model AlertRule {
  id        String        @id @default(uuid())
  orgId     String
  name      String
  condition String
  severity  AlertSeverity
  active    Boolean       @default(true)

  org       Organisation    @relation(fields: [orgId], references: [id])
  instances AlertInstance[]

  @@index([orgId])
}

model AlertInstance {
  id        String        @id @default(uuid())
  orgId     String
  ruleId    String?
  title     String
  building  String
  detail    String
  severity  AlertSeverity
  status    AlertStatus   @default(NEW)
  triggered DateTime      @default(now())

  org  Organisation @relation(fields: [orgId], references: [id])
  rule AlertRule?   @relation(fields: [ruleId], references: [id])

  @@index([orgId])
}

model NotificationPreference {
  id        String  @id @default(uuid())
  userId    String
  channel   String
  frequency String  @default("realtime")
  enabled   Boolean @default(true)

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Document {
  id           String    @id @default(uuid())
  orgId        String
  buildingId   String?
  docType      String
  name         String
  fileUrl      String?
  tags         String[]
  uploadedById String?
  version      Int       @default(1)
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())

  org Organisation @relation(fields: [orgId], references: [id])

  @@index([orgId])
}

model ActivityLog {
  id          String   @id @default(uuid())
  orgId       String
  userId      String?
  entityType  String
  entityId    String
  action      String
  detailsJson Json?
  createdAt   DateTime @default(now())

  org Organisation @relation(fields: [orgId], references: [id])

  @@index([orgId])
}

model CapexRequest {
  id          String     @id @default(uuid())
  orgId       String
  project     String
  building    String
  amountInr   Int
  paybackYrs  Float
  requestedBy String
  stage       CapexStage @default(FM)
  createdAt   DateTime   @default(now())

  org Organisation @relation(fields: [orgId], references: [id])

  @@index([orgId])
}

model GhgInventory {
  id     String @id @default(uuid())
  orgId  String
  year   Int
  scope1 Int    @default(0)
  scope2 Int    @default(0)
  scope3 Int    @default(0)

  org Organisation @relation(fields: [orgId], references: [id])

  @@index([orgId])
}

model IntervalReading {
  id         String   @id @default(uuid())
  buildingId String
  ts         DateTime
  kwh        Float
  kw         Float?
  pf         Float?

  building Building @relation(fields: [buildingId], references: [id])

  @@index([buildingId, ts])
}

// Corrections-capture loop (Stage G): every reviewed extraction is logged with
// the model's value + confidence vs the user's final value, per field. Feeds
// training data and the per-DISCOM accuracy view. `corrections` is an array of
// { fieldKey, extracted, extractedConfidence, final, corrected }.
model ExtractionFeedback {
  id             String   @id @default(uuid())
  orgId          String
  provider       String // anthropic | openai | bbps | bbps-demo | sample
  model          String   @default("")
  source         String // vision | pdf-text | bbps | bbps-demo | sample
  discom         String   @default("")
  // DISCOM whose template was applied at extraction ("" = none). Drives the
  // with-template vs without accuracy comparison.
  templateApplied String  @default("")
  fieldsTotal    Int      @default(0)
  fieldsFound    Int      @default(0)
  correctedCount Int      @default(0)
  corrections    Json
  createdAt      DateTime @default(now())

  org Organisation @relation(fields: [orgId], references: [id])

  @@index([orgId])
  @@index([discom])
  @@index([createdAt])
}

// ------------------------------------------------ collection agent (money)
// All monetary values are integer PAISE (BigInt) — never floats. Status is an
// explicit state machine; commission is computed at confirm time from the
// license's model. See server/src/collections/.

enum CollectionMode {
  BBPS // via a BBPOU / Agent-Institution aggregator (per-txn commission, T+1 NPCI settlement)
  DIRECT // a DISCOM's own agency portal/API (%-commission, deposit/float, daily reconciliation)
  MANUAL // offline cash recorded by a field agent
}

enum CommissionType {
  PER_TXN // flat paise per transaction (typical BBPS)
  PERCENT // basis points of the amount collected
  PERCENT_SPLIT // separate bps for current vs outstanding/arrears (MSEDCL-style)
}

enum LicenseStatus {
  SANDBOX
  ACTIVE
  SUSPENDED
}

enum CollectionMethod {
  CASH
  UPI
  CARD
  NETBANKING
  BBPS
}

enum CollectionStatus {
  INITIATED // recorded, money not yet confirmed in hand
  CONFIRMED // consumer payment received by the agent
  REMITTED // settled to the DISCOM in a remittance batch
  RECONCILED // matched against the DISCOM settlement report
  FAILED
  REFUNDED
}

enum RemittanceStatus {
  PENDING
  SETTLED
  RECONCILED
}

model DiscomLicense {
  id                       String          @id @default(uuid())
  orgId                    String
  discom                   String
  billerId                 String          @default("") // BBPS biller id (mode=BBPS)
  mode                     CollectionMode
  aggregator               String          @default("") // billavenue/setu (BBPS) or DISCOM portal (DIRECT)
  status                   LicenseStatus   @default(SANDBOX)
  commissionType           CommissionType
  commissionPerTxnPaise    BigInt          @default(0)
  commissionRateBps        Int             @default(0) // PERCENT
  commissionCurrentBps     Int             @default(0) // PERCENT_SPLIT (current)
  commissionOutstandingBps Int             @default(0) // PERCENT_SPLIT (arrears)
  commissionCapPaise       BigInt          @default(0) // 0 = no cap
  commissionMinPaise       BigInt          @default(0)
  settlementCycle          String          @default("T+1")
  floatPaise               BigInt          @default(0) // working-capital balance
  createdAt                DateTime        @default(now())

  org         Organisation @relation(fields: [orgId], references: [id])
  collections Collection[]
  remittances Remittance[]

  @@index([orgId])
}

model Collection {
  id              String           @id @default(uuid())
  orgId           String
  licenseId       String
  billId          String? // links to the ElectricityBill obligation (payments layer)
  consumerNumber  String           @default("")
  amountPaise     BigInt
  isOutstanding   Boolean          @default(false) // arrears recovery → split-commission rate
  method          CollectionMethod
  status          CollectionStatus @default(INITIATED)
  idempotencyKey  String
  providerRef     String           @default("") // connector/txn ref (no double-collect)
  commissionPaise BigInt           @default(0)
  collectedAt     DateTime         @default(now())
  remittanceId    String?
  createdAt       DateTime         @default(now())

  org        Organisation  @relation(fields: [orgId], references: [id])
  license    DiscomLicense @relation(fields: [licenseId], references: [id])
  remittance Remittance?   @relation(fields: [remittanceId], references: [id])

  @@unique([orgId, idempotencyKey])
  @@index([orgId])
  @@index([licenseId])
  @@index([status])
}

model Remittance {
  id              String           @id @default(uuid())
  orgId           String
  licenseId       String
  periodDate      DateTime
  grossPaise      BigInt           @default(0) // total collected from consumers
  remittedPaise   BigInt           @default(0) // settled to the DISCOM
  commissionPaise BigInt           @default(0) // our earnings back
  count           Int              @default(0)
  status          RemittanceStatus @default(PENDING)
  reconciledAt    DateTime?
  createdAt       DateTime         @default(now())

  org         Organisation  @relation(fields: [orgId], references: [id])
  license     DiscomLicense @relation(fields: [licenseId], references: [id])
  collections Collection[]

  @@index([orgId])
  @@index([licenseId])
}

// ---------------------------------------------------------------- auth
// Global identity index for login bootstrapping: maps an email to its org BEFORE
// any tenant context exists. Deliberately NOT under row-level security (it is
// the lookup that establishes which org you belong to). One account per email.
model Account {
  id        String   @id @default(uuid())
  email     String   @unique
  orgId     String
  userId    String
  // DPDP consent: recorded at signup (explicit action on the privacy notice).
  consentAt      DateTime?
  consentVersion String   @default("")
  createdAt DateTime @default(now())
}
