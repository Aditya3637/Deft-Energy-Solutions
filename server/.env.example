# PostgreSQL connection (use a local or hosted Postgres; TimescaleDB for interval data later)
DATABASE_URL="postgresql://deft:deft@localhost:5432/deft?schema=public"

# API
PORT=4000
# Comma-separated allowed origins for CORS (the Pages frontend, local dev)
CORS_ORIGINS="http://localhost:3000,https://aditya3637.github.io"

# =========================== Bill extraction (Stage G) ===========================
# POST /v1/extract. Pick a provider; without one configured the endpoint returns
# 503 and the frontend falls back to the sample bill.
#
# EXTRACT_PROVIDER: "anthropic" (default) | "openai"
#   anthropic — Claude vision. PDFs + images. Highest accuracy. Paid.
#   openai    — any OpenAI-compatible host (Llama via Groq / Meta Llama API /
#               OpenRouter / Together, Gemini-compat, or self-hosted Ollama).
#               IMAGES ONLY (upload a photo/screenshot; PDFs need the anthropic
#               provider). Free / low-cost tiers available — see options below.
EXTRACT_PROVIDER="anthropic"

# --- anthropic provider ---
ANTHROPIC_API_KEY=""
# Vision model. Default claude-opus-4-8 (most accurate); claude-haiku-4-5 is ~5x cheaper.
EXTRACT_MODEL="claude-opus-4-8"
# Optional: override the Anthropic API base (gateway/proxy).
# ANTHROPIC_BASE_URL="https://api.anthropic.com"

# --- openai-compatible provider (free / low-cost Llama, Gemini, or self-hosted) ---
# Set EXTRACT_PROVIDER=openai and choose ONE host below (uncomment + fill).
# EXTRACT_API_KEY=""            # provider key (omit for self-hosted Ollama)
# EXTRACT_BASE_URL=""           # e.g. https://api.groq.com/openai/v1
# EXTRACT_MODEL=""              # e.g. meta-llama/llama-4-scout-17b-16e-instruct
# EXTRACT_JSON_MODE="1"         # send response_format:json_object (Groq/Together/Gemini support it)
#
#   Groq (free tier):        EXTRACT_BASE_URL=https://api.groq.com/openai/v1
#                            EXTRACT_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
#   Meta Llama API (preview):EXTRACT_BASE_URL=https://api.llama.com/compat/v1
#                            EXTRACT_MODEL=Llama-4-Maverick-17B-128E-Instruct-FP8
#   OpenRouter (free model): EXTRACT_BASE_URL=https://openrouter.ai/api/v1
#                            EXTRACT_MODEL=meta-llama/llama-3.2-11b-vision-instruct:free
#   Google Gemini (free):    EXTRACT_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#                            EXTRACT_MODEL=gemini-2.0-flash
#   Ollama (self-host, $0):  EXTRACT_BASE_URL=http://localhost:11434/v1
#                            EXTRACT_MODEL=llama3.2-vision   (no EXTRACT_API_KEY)

# ===================== BBPS / DISCOM-portal bill fetch (Stage G) =====================
# GET /v1/billfetch/billers, POST /v1/billfetch. Fetches a bill SUMMARY (amount,
# due date, name) by consumer number — complements upload/OCR, doesn't replace it.
#
# BILLFETCH_PROVIDER: "mock" (default — built-in demo summary, no account) | "bbps"
BILLFETCH_PROVIDER="mock"
# --- bbps provider: a real aggregator (Setu/Pine Labs, Cashfree, Razorpay, Decentro, Zoop...) ---
# BBPS is NPCI-run; there is no free public API — you go through a paid aggregator.
# BILLFETCH_BASE_URL=""          # aggregator "fetch bill" endpoint
# BILLFETCH_API_KEY=""           # aggregator key (sent as Bearer)
# BILLFETCH_AMOUNT_IN_PAISE="1"  # set if the aggregator returns amounts in paise
# Note: fill real BBPS biller IDs per DISCOM in server/src/billfetch/biller-catalog.ts
# (from your aggregator's biller directory). The generic adapter maps common
# response fields and may need per-aggregator tweaks.

# ===================== IEX / power-exchange price feed (Stage G) =====================
# GET /v1/markets/iex. Without a feed, returns the INDICATIVE day-ahead reference
# (source="indicative"); the Markets page labels it as such. Set a feed to go live.
# IEX_PROVIDER: "mock" (default — indicative reference) | "http" (a market-data feed)
IEX_PROVIDER="mock"
# IEX_BASE_URL=""   # day-ahead price endpoint (returns a block/price series)
# IEX_API_KEY=""    # provider key (sent as Bearer)
# The generic adapter maps common field names (hour/timeBlock, price/mcp) and
# may need per-provider tweaks — see server/src/markets/iex/iex-core.ts.

# ==================== Carbon-credit (CCTS) registry feed (Stage G) ====================
# Feeds GET /v1/markets (carbonCredits). Without an account, the view shows the
# ESTIMATED credit potential (from avoided emissions); a registry returns the
# org's real held/retired certificates (source="registry").
# REGISTRY_PROVIDER: "mock" (default — estimated, no holdings) | "http" (a registry)
REGISTRY_PROVIDER="mock"
# REGISTRY_BASE_URL=""   # registry holdings endpoint (org account passed as ?account=)
# REGISTRY_API_KEY=""    # registry key (sent as Bearer)

# ========================= Subscriptions & billing (monetization) =========================
# Plan tiers + entitlements are enforced server-side (server/src/billing/). Checkout
# uses a provider seam. Without a gateway, MANUAL mode works (invoice / sandbox
# self-activate); Razorpay activates real payments when configured.
# PAYMENTS_PROVIDER: "manual" (default) | "razorpay"
PAYMENTS_PROVIDER="manual"
# --- razorpay provider (real money) ---
# RAZORPAY_KEY_ID=""        # from the Razorpay dashboard
# RAZORPAY_KEY_SECRET=""
# RAZORPAY_WEBHOOK_SECRET=""  # webhook → POST /v1/billing/webhook. Subscribe events:
#   payment_link.paid, subscription.activated/charged (activate),
#   subscription.pending (→ 7-day dunning grace), subscription.halted/cancelled (downgrade).
# --- recurring (auto-renewing) subscriptions ---
# Create a monthly Razorpay Plan (₹4,999) in the dashboard and put its id here.
# When set, checkout creates a recurring Subscription; when unset, it falls back
# to a one-time Payment Link per period.
# RAZORPAY_PLAN_ID_PRO=""
# APP_URL is reused (auth section) for the payment callback redirect.
# A no-card 14-day Pro trial (POST /v1/billing/trial) needs no payment config.

# =================== Collection agent — BBPS rail (Stage G, §7) ===================
# OFF by default (mock connector). Turn on only with a real Agent-Institution /
# BBPOU sandbox after onboarding + UAT. See docs/COLLECTION-AGENT.md & PLAN §7.
# COLLECTIONS_LIVE="1"                              # gate: use the real BBPS connector
# BBPS_BASE_URL="https://sandbox-coudc.setu.co"     # UAT/sandbox base (prod differs)
# BBPS_CLIENT_ID=""                                 # issued after agent onboarding/UAT
# BBPS_CLIENT_SECRET=""
# BBPS_PRODUCT_INSTANCE_ID=""                       # e.g. Setu product instance id
# BBPS_AGENT_ID=""                                  # agent / outlet id
# Exact endpoints/field names vary by aggregator (Setu/Cashfree/BillAvenue/PayU) —
# confirm against their live docs at certification (PLAN §7, G7.4).

# =============================== Auth (Stage H) ===============================
# Session/magic-link signing secret. REQUIRED in production (a dev fallback keeps
# the sandbox working but is insecure). Generate: openssl rand -hex 32
AUTH_SECRET=""
# Frontend base URL used to build the magic link (e.g. the Vercel/Pages URL).
APP_URL=""
# The magic link is now emailed via the notification layer (below). With the
# default "log" email provider it's logged (not actually sent); set a real
# provider to deliver it. AUTH_REVEAL_LINK=1 also returns it in the API response
# (sandbox/testing only).
# AUTH_REVEAL_LINK=""

# ========================= Notifications (delivery layer) =========================
# Magic-link + dunning emails go through server/src/notifications/. Default "log"
# provider works with no account (logs the message); set a real provider to send.
# --- email ---
# NOTIFY_EMAIL_PROVIDER="resend"      # log (default) | resend
# RESEND_API_KEY=""                   # from resend.com
# NOTIFY_EMAIL_FROM="Deft Energy <noreply@yourdomain>"
# --- sms (generic gateway: point at MSG91/Twilio/Gupshup; tweak the body) ---
# NOTIFY_SMS_PROVIDER="http"          # log (default) | http
# NOTIFY_SMS_URL=""                   # gateway endpoint (receives { to, text })
# NOTIFY_SMS_KEY=""                   # sent as Bearer
