# PostgreSQL connection (use a local or hosted Postgres; TimescaleDB for interval data later)
DATABASE_URL="postgresql://deft:deft@localhost:5432/deft?schema=public"

# API
PORT=4000
# Comma-separated allowed origins for CORS (the Pages frontend, local dev)
CORS_ORIGINS="http://localhost:3000,https://aditya3637.github.io"

# Bill extraction (Stage G) — POST /v1/extract. Without a key the endpoint
# returns 503 and the frontend falls back to the sample bill.
ANTHROPIC_API_KEY=""
# Vision model for extraction (optional). Default claude-opus-4-8 (most accurate).
# Set claude-haiku-4-5 to trade some accuracy for ~5x lower cost at volume.
EXTRACT_MODEL="claude-opus-4-8"
# Optional: override the Anthropic API base (e.g. a gateway/proxy).
# ANTHROPIC_BASE_URL="https://api.anthropic.com"
