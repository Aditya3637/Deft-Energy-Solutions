# PostgreSQL connection (use a local or hosted Postgres; TimescaleDB for interval data later)
DATABASE_URL="postgresql://deft:deft@localhost:5432/deft?schema=public"

# API
PORT=4000
# Comma-separated allowed origins for CORS (the Pages frontend, local dev)
CORS_ORIGINS="http://localhost:3000,https://aditya3637.github.io"

# =========================== Bill extraction (Stage G) ===========================
# POST /v1/extract. Pick a provider; without one configured the endpoint returns
# 503 and the frontend falls back to the sample bill.
#
# EXTRACT_PROVIDER: "anthropic" (default) | "openai"
#   anthropic — Claude vision. PDFs + images. Highest accuracy. Paid.
#   openai    — any OpenAI-compatible host (Llama via Groq / Meta Llama API /
#               OpenRouter / Together, Gemini-compat, or self-hosted Ollama).
#               IMAGES ONLY (upload a photo/screenshot; PDFs need the anthropic
#               provider). Free / low-cost tiers available — see options below.
EXTRACT_PROVIDER="anthropic"

# --- anthropic provider ---
ANTHROPIC_API_KEY=""
# Vision model. Default claude-opus-4-8 (most accurate); claude-haiku-4-5 is ~5x cheaper.
EXTRACT_MODEL="claude-opus-4-8"
# Optional: override the Anthropic API base (gateway/proxy).
# ANTHROPIC_BASE_URL="https://api.anthropic.com"

# --- openai-compatible provider (free / low-cost Llama, Gemini, or self-hosted) ---
# Set EXTRACT_PROVIDER=openai and choose ONE host below (uncomment + fill).
# EXTRACT_API_KEY=""            # provider key (omit for self-hosted Ollama)
# EXTRACT_BASE_URL=""           # e.g. https://api.groq.com/openai/v1
# EXTRACT_MODEL=""              # e.g. meta-llama/llama-4-scout-17b-16e-instruct
# EXTRACT_JSON_MODE="1"         # send response_format:json_object (Groq/Together/Gemini support it)
#
#   Groq (free tier):        EXTRACT_BASE_URL=https://api.groq.com/openai/v1
#                            EXTRACT_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
#   Meta Llama API (preview):EXTRACT_BASE_URL=https://api.llama.com/compat/v1
#                            EXTRACT_MODEL=Llama-4-Maverick-17B-128E-Instruct-FP8
#   OpenRouter (free model): EXTRACT_BASE_URL=https://openrouter.ai/api/v1
#                            EXTRACT_MODEL=meta-llama/llama-3.2-11b-vision-instruct:free
#   Google Gemini (free):    EXTRACT_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#                            EXTRACT_MODEL=gemini-2.0-flash
#   Ollama (self-host, $0):  EXTRACT_BASE_URL=http://localhost:11434/v1
#                            EXTRACT_MODEL=llama3.2-vision   (no EXTRACT_API_KEY)

# ===================== BBPS / DISCOM-portal bill fetch (Stage G) =====================
# GET /v1/billfetch/billers, POST /v1/billfetch. Fetches a bill SUMMARY (amount,
# due date, name) by consumer number — complements upload/OCR, doesn't replace it.
#
# BILLFETCH_PROVIDER: "mock" (default — built-in demo summary, no account) | "bbps"
BILLFETCH_PROVIDER="mock"
# --- bbps provider: a real aggregator (Setu/Pine Labs, Cashfree, Razorpay, Decentro, Zoop...) ---
# BBPS is NPCI-run; there is no free public API — you go through a paid aggregator.
# BILLFETCH_BASE_URL=""          # aggregator "fetch bill" endpoint
# BILLFETCH_API_KEY=""           # aggregator key (sent as Bearer)
# BILLFETCH_AMOUNT_IN_PAISE="1"  # set if the aggregator returns amounts in paise
# Note: fill real BBPS biller IDs per DISCOM in server/src/billfetch/biller-catalog.ts
# (from your aggregator's biller directory). The generic adapter maps common
# response fields and may need per-aggregator tweaks.
