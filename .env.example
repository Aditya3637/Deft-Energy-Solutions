# Frontend env. Copy to .env.local for local dev.

# Live backend base URL (e.g. https://deft-energy-server.onrender.com).
# Leave UNSET to run on fixtures (the default for the static Pages demo).
# When set, client-side actions (e.g. "Save to workspace" in /analyze) call the
# real API. NEXT_PUBLIC_* is embedded at build time.
NEXT_PUBLIC_API_URL=
